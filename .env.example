# Backend Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Leave blank or use sqlite for local dev; supply postgresql:// for Neon/Railway/Render)
DATABASE_URL=sqlite:///./translator.db

# Translation Provider Options: google | huggingface | mymemory
TRANSLATION_PROVIDER=google

# Hugging Face Configuration (Optional, required only if TRANSLATION_PROVIDER=huggingface)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=facebook/nllb-200-distilled-600M

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://localhost:8000
