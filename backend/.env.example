PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database URL - Leave as SQLite default for local zero-config, or use PostgreSQL connection string
DATABASE_URL=sqlite:///./translator.db
# PostgreSQL Example: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/translator?sslmode=require

# Provider: google | huggingface | mymemory
TRANSLATION_PROVIDER=google

# Hugging Face (Optional, for AI multilingual model translation)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=facebook/nllb-200-distilled-600M
